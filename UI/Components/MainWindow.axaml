<Window x:Class="Jido.UI.Components.MainWindow" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sidebar="using:Jido.UI.Components.Common.Sidebar"
        xmlns:vm="using:Jido.UI.Components" Title="Jido" Width="1080" Height="640"
        MinWidth="900" MinHeight="560"
        d:DesignHeight="640" d:DesignWidth="1080" x:DataType="vm:MainWindowViewModel"
        Focusable="True"
        FontFamily="{StaticResource Nunito}"
        Icon="avares://Jido/UI/Assets/Images/avalonia-logo.ico"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        mc:Ignorable="d">

    <Design.DataContext>
        <!--
        This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">
        <!--  Title bar  -->
        <Grid Grid.Row="0" Background="{DynamicResource Highlight500}" Height="36"
              ColumnDefinitions="Auto, *, Auto"
              PointerPressed="OnTitleBarPointerPressed">
            <Image Margin="8,2,0,0" Source="avares://Jido/UI/Assets/Images/logo.png" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="titlebar-btn" Click="OnMinimizeClick">
                    <i:Icon Value="fa-window-minimize" FontSize="11" />
                </Button>
                <Button Classes="titlebar-btn" Click="OnMaximizeClick">
                    <i:Icon Value="fa-window-maximize" FontSize="11" />
                </Button>
                <Button Classes="titlebar-btn titlebar-btn-close" Click="OnCloseClick">
                    <i:Icon Value="fa-xmark" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Classes="sidebar" ColumnDefinitions="220, *">
            <!--  Side bar  -->
            <sidebar:SidebarView Grid.Column="0" DataContext="{Binding Sidebar}" />
            <!--  Main content  -->
            <Border Grid.Column="1">
                <ContentControl Content="{Binding Content}" />
            </Border>
        </Grid>
        <!--  Footer  -->
        <!--<Grid Grid.Row="2" Background="{DynamicResource Highlight200}" ColumnDefinitions="Auto, *, Auto">
        <Border Grid.Column="0">
        <Label>Label</Label>
        </Border>
        <Border Grid.Column="2">
        <Label>Buttons</Label>
        </Border>
        </Grid>-->
    </Grid>
</Window>
