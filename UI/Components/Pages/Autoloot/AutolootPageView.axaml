<UserControl x:Class="Jido.UI.Components.Pages.Autoloot.AutolootPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:Jido.UI.Components.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jido.UI.Components.Pages.Autoloot" d:DesignHeight="450"
             d:DesignWidth="800" x:CompileBindings="True"
             x:DataType="vm:AutolootPageViewModel" mc:Ignorable="d">
    <Design.DataContext>
        <vm:AutolootPageViewModel />
    </Design.DataContext>
    <common:PageWithHeader Title="Autoloot" Subtitle="Reads the screen periodically, and clicks on detected shapes">
        <StackPanel HorizontalAlignment="Center">

            <!--  GENERAL  -->
            <TextBlock Margin="0,10,0,5" FontSize="16" FontWeight="Bold" Text="General" />
            <Grid ColumnDefinitions="Auto, 5, *, 5, Auto" RowDefinitions="Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Text="Toggle key" />
                <TextBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" IsReadOnly="True"
                         Text="{Binding ToggleKey, Converter={StaticResource KeyCodeConverter}}" />
                <Button Grid.Row="0" Grid.Column="4" VerticalAlignment="Center"
                        Command="{Binding ChangeKeyCommand}"
                        Content="{Binding ChangeKeyButtonText}" />
            </Grid>

            <!--  CONFIGURATION  -->
            <TextBlock Margin="0,15,0,5" FontSize="16" FontWeight="Bold" Text="Configuration" />
            <Grid ColumnDefinitions="Auto, 5, *, 5, Auto" RowDefinitions="Auto, 5, Auto, 5, Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Text="Cycle delay" />
                <NumericUpDown Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                               Minimum="1" Maximum="60000" Increment="50"
                               FormatString="0" ParsingNumberStyle="Integer"
                               Value="{Binding CycleDelayMs}" />
                <common:FieldLabel Grid.Row="0" Grid.Column="4" HorizontalAlignment="Left"
                                   Margin="4,0,0,0" Text="ms"
                                   Hint="How long to wait between each screen capture and click cycle" />

                <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Text="Capture ratio" />
                <NumericUpDown Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                               Minimum="1" Maximum="100" Increment="5"
                               FormatString="0" ParsingNumberStyle="Integer"
                               Value="{Binding CaptureRatioPercent}" />
                <common:FieldLabel Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left"
                                   Margin="4,0,0,0" Text="%"
                                   Hint="Portion of the screen to scan. Lower values improve performance but may miss items near the edges." />

                <Button Grid.Row="4" Grid.Column="4" HorizontalAlignment="Right" Classes="save"
                        Command="{Binding SaveAutolootConfigCommand}">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Margin="0,0,5,0" Value="{Binding SaveState.Icon}" />
                        <TextBlock Text="{Binding SaveState.Text}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  STATS  -->
            <TextBlock Margin="0,15,0,5" FontSize="16" FontWeight="Bold" Text="Stats" />
            <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto">
                <TextBlock Grid.Column="0" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Text="Avg cycle" />
                <TextBlock Grid.Column="2" Margin="5,0,0,0" VerticalAlignment="Center"
                           Text="{Binding AvgCycleMs}" />
            </Grid>

        </StackPanel>
    </common:PageWithHeader>
</UserControl>
