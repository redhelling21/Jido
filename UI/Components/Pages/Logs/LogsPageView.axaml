<UserControl x:Class="Jido.UI.Components.Pages.Logs.LogsPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:Jido.UI.Components.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Jido.UI.Components.Pages.Logs"
             d:DesignHeight="450" d:DesignWidth="800"
             x:CompileBindings="True" x:DataType="vm:LogsPageViewModel"
             mc:Ignorable="d">
    <Design.DataContext>
        <vm:LogsPageViewModel />
    </Design.DataContext>
    <common:PageWithHeader Title="Logs" Subtitle="Application logs output">
        <DockPanel>

            <!--  Toolbar  -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Margin="0,0,5,0" Value="fa fa-trash" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <CheckBox Content="Debug" IsChecked="{Binding ShowDebug}" />
                    <CheckBox Content="Info" IsChecked="{Binding ShowInfo}" />
                    <CheckBox Content="Warning" IsChecked="{Binding ShowWarning}" />
                    <CheckBox Content="Error" IsChecked="{Binding ShowError}" />
                </StackPanel>
            </DockPanel>

            <!--  Log list  -->
            <Border Background="{DynamicResource Surface}" CornerRadius="5" Padding="8" Margin="0,0,0,15">
                <!--  ListBox virtualizes, ItemsControl does not  -->
                <ListBox Name="LogList"
                         ItemsSource="{Binding DisplayedEntries}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="SelectableTextBlock.debug">
                            <Setter Property="Foreground" Value="{DynamicResource LogDebug}" />
                        </Style>
                        <Style Selector="SelectableTextBlock.info">
                            <Setter Property="Foreground" Value="{DynamicResource LogInfo}" />
                        </Style>
                        <Style Selector="SelectableTextBlock.warning">
                            <Setter Property="Foreground" Value="{DynamicResource LogWarning}" />
                        </Style>
                        <Style Selector="SelectableTextBlock.error">
                            <Setter Property="Foreground" Value="{DynamicResource LogError}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryViewModel">
                            <SelectableTextBlock Text="{Binding Text}"
                                                 Classes.debug="{Binding IsDebug}"
                                                 Classes.info="{Binding IsInfo}"
                                                 Classes.warning="{Binding IsWarning}"
                                                 Classes.error="{Binding IsError}"
                                                 FontFamily="Consolas,Courier New,monospace"
                                                 FontSize="12"
                                                 TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

        </DockPanel>
    </common:PageWithHeader>
</UserControl>
